# 环境变量模板 —— 复制为 .env 后按需填写
# 代码通过 python-dotenv 读取（summary_api / vector_semantic / rag_knowledge 均 load_dotenv）

# 必填：DeepSeek API Key（用于程序性记忆 SKILL 生成 / LLM 摘要 / RAG 重排序）
DEEPSEEK_API_KEY=

# Ollama embedding 服务（bge-m3 模型）
# 代码中当前为硬编码常量 http://localhost:11434/api/embed，此处仅为文档化预留
OLLAMA_URL=http://localhost:11434

# 数据库连接（当前在 db_pool.py / 各 *_api.py 中硬编码，与 docker-compose.yml 一致）
# 预留：后续若改为从环境变量读取，按此模板填写
PG_HOST=localhost
PG_PORT=5432
PG_DB=memory_system
PG_USER=memory_user
PG_PASSWORD=memory_pass_2026

# Redis（当前在 cache_manager.py / event_bus.py 中硬编码）
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
